PORT=5000
MONGO_URI=mongodb://localhost:27017/ai-hub

# gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# base url of n8n's production webhooks (workflows must be active)
N8N_WEBHOOK_URL=http://localhost:5678/webhook
# optional bearer token, leave empty for dev (n8n routes stay open)
N8N_AUTH_HEADER=
